# ===================================================================
# /etc/cid-backup.env  — installed copy, NOT in git.
# This template lives in the repo; copy it to /etc/cid-backup.env with
# 0600 root perms after filling in the values.
#
# Sourced by /usr/local/bin/cid-backup (scripts/cid-backup.sh).
# ===================================================================

# --- Where to put backups ---
# For Backblaze B2:    b2:<bucket-name>:<optional/path>
# For AWS S3:          s3:s3.amazonaws.com/<bucket-name>/<optional/path>
# For Cloudflare R2:   s3:<account-id>.r2.cloudflarestorage.com/<bucket-name>
# For local testing:   /var/backups/cid-restic   (a directory on this host)
RESTIC_REPOSITORY=b2:CHANGEME-bucket-name:cid

# --- Restic encryption passphrase ---
# Generated fresh per host. If lost, every snapshot becomes unreadable
# forever. Keep a copy in your password manager.
RESTIC_PASSWORD=CHANGEME-strong-random-passphrase

# --- Backblaze B2 credentials ---
# From https://secure.backblaze.com/app_keys.htm — "Add a New Application Key".
# Scope the key to ONE bucket with Read+Write only.
B2_ACCOUNT_ID=CHANGEME-keyID
B2_ACCOUNT_KEY=CHANGEME-applicationKey

# --- AWS S3 / Cloudflare R2 credentials (alternative to B2) ---
# Uncomment if you switch RESTIC_REPOSITORY to s3:...
# AWS_ACCESS_KEY_ID=CHANGEME
# AWS_SECRET_ACCESS_KEY=CHANGEME
