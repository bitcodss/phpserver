# Environment secrets
docker/.env

# Logs
docker/logs/

# Runtime data
docker/database/*.sql.tmp

# OS files
.DS_Store
Thumbs.db

# OpenClaw workspace state
.openclaw/

# Memory (agent-specific)
memory/

# Backup engine runtime state (UI-edited; bootstrapped by broker from .example)
sites/opc.bitco.link/public/admin/data/backup-jobs.json
sites/opc.bitco.link/public/admin/data/backup-state.json
# Restore-drill history — operational state, appended at each drill run.
sites/opc.bitco.link/public/admin/data/drill-history.json
# System metrics rolling buffer — runtime-written every 5 min by metrics.php.
sites/opc.bitco.link/public/admin/data/metrics.json

# Agent config files (not part of the stack)
SOUL.md
IDENTITY.md
USER.md
TOOLS.md
AGENTS.md
HEARTBEAT.md
BOOTSTRAP.md
