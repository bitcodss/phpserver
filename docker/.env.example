# Copy this to .env and set your own passwords.
# After changing any value, recreate the stack: docker compose up -d --force-recreate

# --- MariaDB ---
MYSQL_ROOT_PASSWORD=ChangeMe_RootPass!
MYSQL_DATABASE=opc_db
MYSQL_USER=opc_user
MYSQL_PASSWORD=ChangeMe_UserPass!

# --- Survey app (opc2.bitco.link) ---
# Credentials the survey PHP app uses to connect to MariaDB.
OPC2_DB_HOST=mariadb
OPC2_DB_NAME=dw_cressida
OPC2_DB_USER=dw_spy
OPC2_DB_PASSWORD=ChangeMe_SurveyPass!

# Static tokens used by status.php and the xls/exportxls.php download.
# Treat these as secrets even though the consumer is hardcoded.
OPC2_STATUS_TOKEN=ChangeMe_StatusToken
OPC2_RAWDATA_TOKEN=ChangeMe_RawdataToken

# --- Admin dashboard (opc.bitco.link/admin/) ---
ADMIN_USER=admin
# bcrypt hash of the admin password. Generate with:
#   docker run --rm php:7.4-cli php -r "echo password_hash('YourPassword', PASSWORD_BCRYPT), PHP_EOL;"
ADMIN_PASS_HASH=$2y$10$ChangeMeReplaceWithRealBcryptHash................

# --- SFTP ---
SFTP_USER=webmaster
SFTP_PASSWORD=ChangeMe_SftpPass!
